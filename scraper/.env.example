# Copy to .env, or just export these before running python run.py.
# Same DB_* values as backend/.env.example - both point at one database.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nexus
DB_USER=postgres
DB_PASSWORD=postgres

# Leave blank to use the offline regex-based extraction fallback instead
# of the real Claude API - see extract.py.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Leave blank to use the offline hashing-trick embedding fallback instead
# of real Voyage AI embeddings - see embed.py.
VOYAGE_API_KEY=

# true = read local fixtures/ instead of the real internet (this project
# was built in a sandbox that can't reach arbitrary sites).
SCRAPE_OFFLINE_MODE=true
